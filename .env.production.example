APP_NAME="HR Media Score"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://score.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Santo_Domingo

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_media_score
DB_USERNAME=hrms
DB_PASSWORD=                   # contraseña fuerte, única

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
# Fase 3: CACHE_STORE=redis, QUEUE_CONNECTION=redis, BROADCAST_CONNECTION=reverb

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@score.example.com"
MAIL_FROM_NAME="HR Media Score"

# Solo para el primer `db:seed`; bórrelas después.
ADMIN_EMAIL=
ADMIN_PASSWORD=
